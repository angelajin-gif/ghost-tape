{
  "name": "ghost-tape",
  "version": "0.1.0",
  "private": true,
  "description": "A letter hidden in sound: an acoustic modem for mixtape letters.",
  "license": "MIT",
  "author": "Angela Jin",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.modem.json && tsc --noEmit -p tsconfig.json",
    "test": "npm run typecheck && vitest run",
    "test:deep": "vitest run --config vitest.deep.config.ts",
    "check:scramble": "node scripts/check-scramble.mjs",
    "demo:wav": "node scripts/make-demo-wav.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
